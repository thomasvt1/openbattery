{
  "domain": "omnibattery",
  "name": "OpenBattery",
  "after_dependencies": [
    "recorder",
    "esphome",
    "mqtt"
  ],
  "codeowners": [
    "@thomasvt1"
  ],
  "config_flow": true,
  "dependencies": [
    "http",
    "frontend",
    "panel_custom"
  ],
  "dhcp": [
    {
      "registered_devices": true
    }
  ],
  "documentation": "https://thomasvt1.github.io/openbattery/",
  "integration_type": "device",
  "iot_class": "local_polling",
  "issue_tracker": "https://github.com/thomasvt1/openbattery/issues",
  "requirements": [
    "pymodbus>=3.8.0"
  ],
  "version": "1.7.0",
  "zeroconf": [
    "_modbus._tcp.local."
  ]
}
